# LangGraph / LangSmith
LANGSMITH_PROJECT=house-agent

# LLM provider
# Do not commit real keys. Copy this file to .env on the server and fill it there.
DEEPSEEK_API_KEY=your-deepseek-api-key

# Local MySQL connection. The Docker backend uses house-mysql:3306 instead.
DB_DIALECT=mysql+pymysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=bitehouse
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-root-password

POSTGRES_DB=house_agent
POSTGRES_USER=house_agent
POSTGRES_PASSWORD=replace-with-your-postgres-password
